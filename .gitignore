backend/venv/
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.env
.env.*
!.env.example

# Local Claude Code worktrees/scratch state — not project config,
# just a local git worktree checkout used during an isolated session.
.claude/

# Throwaway runtime logs from local dev servers
backend/.scratch_backend.log
*.scratch*

# Browser-automation scratch from scripted UI checks: console logs, page
# snapshots and screenshots from a QA session, regenerated every run.
.playwright-mcp/

# Scan runtime records: rewritten by every scan, carrying that run's id,
# timestamps and durations. Only the scan service reads them, and it treats
# them as absent on a fresh checkout. The pipeline's analysis outputs
# (data/ecdat-assets.json and the rest) stay tracked — only these two are
# per-run machine state.
data/ecdat-scan.json
data/ecdat-scan-history.json
